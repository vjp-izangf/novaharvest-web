@page "/ticket"
@model NovaHarvest.Web.Pages.Reservations.TicketModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <title>Justificante de reserva</title>
    <link rel="stylesheet" href="/css/site.css">
</head>

<body data-copy="cliente">

    <h1>Justificante de reserva</h1>

    <p>Reserva: @Model.Ticket.Reservation</p>
    <p>Producto: @Model.Ticket.Product</p>
    <p>Kilos: @Model.Ticket.Kg</p>
    <p>Recogida: @Model.Ticket.Pickup</p>
    <p>Generado el @Model.Ticket.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</p>

</body>

</html>

