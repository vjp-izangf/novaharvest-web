@inject IWebHostEnvironment Env

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="theme-color" content="#8e1b2f">
    <title>@ViewData["Title"] - NovaHarvest</title>
    <link rel="stylesheet" href="/css/site.css">
</head>

<body>
    <header>
        <img src="/img/logo.jpg" alt="Logo de NovaHarvest">
        <h2>NovaHarvest</h2>
        <nav><a href="/">Inicio</a> · <a href="/status">Estado</a> · <a href="/about">Acerca de</a> · <a href="/surplus">Excedente</a></nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>NovaHarvest · IES Valle del Jerte · @DateTime.Now.Year · Entorno: @Env.EnvironmentName</footer>
</body>

</html>